# =====================================================================
# openInvest .env.example
# =====================================================================
# `cp .env.example .env` 之后填上你需要的字段。下面分了三块：
#   1. 必填（不填就跑不起来）
#   2. 推荐填（提升体验，但留空也能跑）
#   3. 调参（有合理默认值，一般不动）

# =====================================================================
# 1. 必填
# =====================================================================

# Direct 路径（Web GUI / cron / 任意 agent run_committee）必须有 LLM key
# Coordinator 路径（Claude Code skill prepare_committee）不需要 key，可留空
#
# 支持任意 OpenAI 兼容 API（DeepSeek / 千问 / 智谱 / Kimi 等）。
# 推荐用 LLM_* 通用变量，DEEPSEEK_* 保留作向后兼容（老 fork 用户不需要迁移）。
#
# === 示例 1：DeepSeek（默认） ===
# LLM_API_KEY=sk-xxx
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-v4-flash
#
# === 示例 2：千问（Aliyun DashScope，OpenAI 兼容模式） ===
# LLM_API_KEY=sk-xxx
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode
# LLM_MODEL=qwen-max
#
# === 示例 3：智谱 AI ===
# LLM_API_KEY=xxx
# LLM_BASE_URL=https://open.bigmodel.cn/api/paas
# LLM_MODEL=glm-4-flash
#
# LLM_PROVIDER 一般不动（默认 openai，给 DSPy/litellm 用）；
# 如果你的 LLM 不是 OpenAI 兼容协议，请在 utils/llm.py 加分支。
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash

# === 向后兼容（老 fork 用户保持原样即可，LLM_* 留空就走这里） ===
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# =====================================================================
# 2. 推荐填（功能开关）
# =====================================================================

# --- 邮件通知（cron daily_report 完成后发委员会摘要）---
# Gmail 必须先开 2FA 再去 https://myaccount.google.com/apppasswords 生成 16 位
# App Password —— 不是登录密码！留空则不发邮件
EMAIL_SENDER=
EMAIL_PASSWORD=
# 报告发到哪个邮箱（不填则发给 EMAIL_SENDER 自己）
DIGEST_EMAIL_TO=

# --- 黄金渠道（如果你持有积存金/纸黄金）---
# 优先级：strategy.target_assets[GC=F] 字段 > 这两个 env > 默认"黄金（自营）"
# 例：浙商积存金 / 工行积存金 / 招行积存金
INVEST_GOLD_CHANNEL=
INVEST_GOLD_DISPLAY=

# --- NapCat QQ Bot（可选，不用 QQ 接收命令就留空）---
# 详见 docs/wiki/01-architecture.md 的 NapCat 接入指南
NAPCAT_WS_URL=
NAPCAT_HTTP_URL=
# 私聊白名单 QQ（必须配置，0 = 拒绝所有，避免公开仓库泄露 QQ）
INVEST_WHITELIST_QQ=0

# =====================================================================
# 3. 调参（一般不动）
# =====================================================================

# --- Web API ---
# Vite dev server (localhost:5173) 放行跨域；生产保持 0
INVEST_WEB_DEV_CORS=0
# 监听地址 / 端口（默认 127.0.0.1:8765；公网入口靠 Caddy 反代）
INVEST_WEB_HOST=127.0.0.1
INVEST_WEB_PORT=8765

# --- Skill GUI 提示 ---
# off / 0 / false → doctor 不告诉 agent "项目自带 Web GUI"，避免明确不要 GUI
# 的高级用户被反复推销
INVEST_GUI_NUDGE=

# --- LLM 调参 ---
# 老变量（保留兼容）：DeepSeek 模型（deepseek-v4-flash 默认/非 thinking；
# deepseek-v4-pro 慢但更准）。旧名 deepseek-chat/deepseek-reasoner 已 deprecated。
# 新用户优先用上面的 LLM_MODEL；这里留空即可。
DEEPSEEK_MODEL=deepseek-v4-flash
# CIO temperature（默认 0.2，越低越保守）
INVEST_LLM_TEMPERATURE=0.2
# 限流重试参数
INVEST_LLM_MAX_ATTEMPTS=3
INVEST_LLM_BASE_DELAY=2.0
INVEST_LLM_MAX_DELAY=30.0

# --- Dreaming（长期记忆 → 洞察）---
# 1 = Deep Sleep 通过阈值的洞察会再走一次 LLM verify pass（更严格但烧 token）
INVEST_DREAMING_LLM_VERIFY=0

# --- 事件感知层（ADR-006，2026-05 加）---
# 默认 ON：jobs/event_watch 每 30 分钟拉新闻 → 归一化 → 命中触发委员会 + 邮件，
# 委员会跑时把相关事件 brief 注入 Macro Strategist prompt（其他 3 角色不污染）。
# 明确不要 → 设 false / 0 / off：
INVEST_EVENT_RAG_ENABLED=true
# 召回时间窗（天）
INVEST_EVENT_RAG_WINDOW_DAYS=7
# 召回最低严重度 (low/mid/high)
INVEST_EVENT_RAG_MIN_SEVERITY=mid
# 召回 top-K 事件
INVEST_EVENT_RAG_TOP_K=8
# event_watch job 每次拉新闻的最大条数（per source）
INVEST_EVENT_MAX_PER_SOURCE=15
# 事件最低严重度才触发委员会重跑（low/mid/high）
INVEST_EVENT_MIN_SEVERITY=mid

# --- 数据陈旧告警 ---
# 价格数据超过 N 天 → daily_report 加 warning（不阻断委员会）
INVEST_PRICE_STALE_DAYS=3
# 价格数据超过 N 天 → 硬终止 daily_report（避免基于陈旧价格做决策）
INVEST_HARD_ABORT_STALE_DAYS=7

# --- PnL 自动 push（可选，仅作者使用）---
# 1 = 每 2h 把 docs/pnl_chart.svg force-push 到 pnl-data 分支供 README 引用
# fork 用户保持 0 即可
INVEST_PNL_AUTOPUSH=0
GITHUB_TOKEN=
INVEST_PNL_PUSH_BRANCH=pnl-data

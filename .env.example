DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com

# SMTP Configuration (Gmail)
EMAIL_SENDER=your_gmail_address@gmail.com
EMAIL_PASSWORD=your_gmail_app_password

# NapCat 私聊白名单 QQ（必须配置，0 = 拒绝所有，避免公开仓库泄露 QQ）
INVEST_WHITELIST_QQ=0

# Web API（connectors/web_api.py）
# 仅绑本机端口；公网入口由 Caddy 反代 + Cloudflare Access 鉴权
# DEV_CORS=1 时为 Vite dev server (localhost:5173) 放行跨域，生产环境保持 0
INVEST_WEB_DEV_CORS=0

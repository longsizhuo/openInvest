HOSTED_DATA_DIR=/srv/openinvest-hosted
HOSTED_ORIGIN=https://openinvest.involutionhell.com
HOSTED_AUTH0_ISSUER=https://YOUR-TENANT.auth0.com/
HOSTED_AUDIENCE=https://openinvest.involutionhell.com/mcp
HOSTED_AUTH0_CLIENT_ID=
HOSTED_AUTH0_CLIENT_SECRET=
# Generate independently; store outside git. Encryption key: 32 bytes, base64 encoded.
HOSTED_ENCRYPTION_KEY=
HOSTED_SESSION_SECRET=
HOSTED_ACTION_SECRET=
HOSTED_ADMIN_TOKEN=
HOSTED_WORKER_IMAGE=openinvest-hosted-worker:local
# Optional when the existing Cloudflare Pages site serves /connect/ directly
HOSTED_PORTAL_DIR=
HOSTED_REGISTRATION_OPEN=0
HOSTED_COS_BUCKET=
HOSTED_COS_SECRET_ID=
HOSTED_COS_SECRET_KEY=
# S3-compatible remote archive (Cloudflare R2). Choose one archive backend.
HOSTED_S3_BUCKET=
HOSTED_S3_ENDPOINT=
HOSTED_S3_REGION=auto
# Prefer a profile with expiring bucket-scoped credential_process credentials.
HOSTED_S3_PROFILE=
AWS_CONFIG_FILE=
HOSTED_S3_ACCESS_KEY_ID=
HOSTED_S3_SECRET_ACCESS_KEY=
# Oracle-only staging alternative: encrypted objects on this host, capped at 2 GiB.
# Keep COS and S3 fields empty when this directory is set. This is not an off-host backup.
HOSTED_ARCHIVE_DIR=
HOSTED_ARCHIVE_BYTES=2147483648
# Install/start openinvest-hosted-network.service before selecting this network.
HOSTED_WORKER_NETWORK=bridge

# Optional: use a distinct namespace for local/staging tests sharing a Docker host.
# HOSTED_WORKER_NAMESPACE=ledger

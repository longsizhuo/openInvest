[Unit]
Description=Invest Web API (FastAPI) — REST 层供 invest-gui 前端消费
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# 部署到自己机器时改 User/Group 为你的用户名（默认 ubuntu）
User=ubuntu
Group=ubuntu
# %h 在 systemd 里展开成本服务 User 的 home dir
# fork 用户：把 INVEST_HOME 改成你 clone openInvest 的位置（默认 ~/openInvest）
Environment=INVEST_HOME=%h/openInvest
WorkingDirectory=%h/openInvest
EnvironmentFile=%h/openInvest/.env
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=TZ=Asia/Shanghai
Environment=UV_CACHE_DIR=%h/openInvest/.uv-cache
# 走 openinvest-web 入口而不是裸 uvicorn：入口带"非 loopback 绑定必须有 INVEST_API_TOKEN"守卫
# （2026-10 评审 D6：裸 uvicorn 绕过它，改一行 --host 就把无鉴权 API 暴露出去）。
# 仅绑 127.0.0.1，公网由 Caddy 反代，CF Access 在边缘鉴权；要改绑非 loopback 地址就必须在 .env 设 INVEST_API_TOKEN，
# 否则进程拒绝启动。（EnvironmentFile 的值优先于上面的 Environment=，.env 里设 INVEST_WEB_HOST 即可覆盖。）
Environment=INVEST_WEB_HOST=127.0.0.1
Environment=INVEST_WEB_PORT=8765
ExecStart=%h/.local/bin/uv run --no-sync openinvest-web
Restart=on-failure
RestartSec=15
StandardOutput=journal
StandardError=journal

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/openInvest

[Install]
WantedBy=multi-user.target
